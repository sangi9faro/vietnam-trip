rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function okDest(d) { return d == null || d in ['pq', 'nt', 'dn']; }

    // 名字：所有人可读，只能写自己的
    match /people/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.at is int;
      allow delete: if isMe(uid);
    }

    // 投票 + 月份：所有人可读，只能写自己的
    match /votes/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['choice', 'months', 'at'])
        && okDest(request.resource.data.choice)
        && request.resource.data.months is list
        && request.resource.data.months.size() <= 12
        && request.resource.data.at is int;
      allow delete: if isMe(uid);
    }

    // 测试结果：所有人可读，只能写自己的
    match /quiz/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['answers', 'scores', 'pcts', 'best', 'at'])
        && request.resource.data.best in ['pq', 'nt', 'dn']
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 30
        && request.resource.data.scores is map
        && request.resource.data.pcts is map
        && request.resource.data.at is int;
      allow delete: if isMe(uid);
    }

    // 留言：所有人可读，作者必须是自己，只能删自己的，不能修改
    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'dest', 'author', 'at'])
        && request.resource.data.author == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && okDest(request.resource.data.dest)
        && request.resource.data.at is int;
      allow update: if false;
      allow delete: if signedIn() && resource.data.author == request.auth.uid;
    }

    // ---------- 工具箱：成员名字 + 汇率（四个人共用一份）----------
    function memberIds() { return ['m1', 'm2', 'm3', 'm4']; }
    match /meta/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && docId == 'settings'
        && request.resource.data.keys().hasOnly(['members', 'rates', 'ratesAt', 'at'])
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly(memberIds())
        && request.resource.data.rates is map
        && request.resource.data.rates.keys().hasOnly(['VND', 'KRW', 'USD'])
        && request.resource.data.at is int;
    }

    // ---------- 工具箱：AA 记账，只能改/删自己记的 ----------
    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'amount', 'currency', 'payer', 'split', 'at', 'by',
                               'mode', 'shares', 'cny', 'rate', 'settled', 'cat', 'day', 'note'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.amount is number && d.amount > 0 && d.amount < 10000000000
        && d.currency in ['CNY', 'VND', 'KRW', 'USD']
        && d.payer in memberIds()
        && d.split is list && d.split.size() >= 1 && d.split.size() <= 4
        && d.split.hasOnly(memberIds())
        && d.at is int
        && (!('mode' in d) || d.mode in ['equal', 'shares', 'amounts'])
        && (!('shares' in d) || (d.shares is map && d.shares.keys().hasOnly(memberIds())))
        && (!('cny' in d) || (d.cny is number && d.cny > 0))
        && (!('rate' in d) || (d.rate is number && d.rate > 0))
        && (!('settled' in d) || d.settled is bool)
        && (!('cat' in d) || d.cat in ['food', 'transport', 'stay', 'fun', 'shop', 'other'])
        && (!('day' in d) || (d.day is string && d.day.size() == 10))
        && (!('note' in d) || (d.note is string && d.note.size() <= 120));
    }
    match /expenses/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validExpense() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && resource.data.by == request.auth.uid
        && validExpense() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // ---------- 工具箱：还款记录，只能删自己记的，不能修改 ----------
    match /settlements/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'amount', 'currency', 'cny', 'method', 'note', 'at', 'by'])
        && request.resource.data.from in memberIds()
        && request.resource.data.to in memberIds()
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount < 10000000000
        && request.resource.data.currency in ['CNY', 'VND', 'KRW', 'USD']
        && request.resource.data.cny is number && request.resource.data.cny > 0
        && request.resource.data.method in ['wechat', 'alipay', 'cash', 'bank', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 60
        && request.resource.data.at is int
        && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // ---------- 工具箱：出发准备清单（每人一份 + 集体一份）----------
    match /checklist/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && docId in ['m1', 'm2', 'm3', 'm4', 'group']
        && request.resource.data.keys().hasOnly(['items', 'at'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 40
        && request.resource.data.at is int;
    }

    // ---------- 工具箱：攻略收藏（只收 http/https 链接，只能删自己加的）----------
    match /links/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'url', 'tag', 'who', 'by', 'at'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('https?://.+')
        && request.resource.data.tag in ['签证', '交通', '住宿', '吃喝', '玩乐', '其他']
        && (request.resource.data.who == '' || request.resource.data.who in memberIds())
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at is int;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // ---------- 投票合集：谁都能发起；每个成员每个投票一票（可改）----------
    function validPoll() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'options', 'multi', 'closed', 'who', 'by', 'at'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.options is list && d.options.size() >= 2 && d.options.size() <= 8
        && d.multi is bool && d.closed is bool
        && (d.who == '' || d.who in memberIds())
        && d.at is int;
    }
    match /polls/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && validPoll() && request.resource.data.by == request.auth.uid
        && request.resource.data.closed == false;
      // creator can only open/close the poll, nothing else
      allow update: if signedIn() && resource.data.by == request.auth.uid && validPoll()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed']);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;

      match /ballots/{mid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && mid in memberIds()
          && request.resource.data.keys().hasOnly(['choices', 'by', 'at'])
          && request.resource.data.choices is list
          && request.resource.data.choices.size() >= 1
          && request.resource.data.choices.size() <= 8
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is int
          && get(/databases/$(database)/documents/polls/$(pid)).data.closed == false;
        // retract own vote while open; the poll's creator can clear all ballots when deleting it
        allow delete: if signedIn() && mid in memberIds()
          && (get(/databases/$(database)/documents/polls/$(pid)).data.closed == false
              || get(/databases/$(database)/documents/polls/$(pid)).data.by == request.auth.uid);
      }
    }
    // collection-group listener for all ballots
    match /{path=**}/ballots/{mid} {
      allow read: if signedIn();
    }

    // ---------- 攻略页：可编辑行程（d1–d6，不能删除文档）----------
    match /days/{dayId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && dayId in ['d1', 'd2', 'd3', 'd4', 'd5', 'd6']
        && request.resource.data.keys().hasOnly(['label', 'date', 'title', 'color', 'locations', 'rev', 'who', 'by', 'at'])
        && request.resource.data.label is string && request.resource.data.label.size() <= 20
        && request.resource.data.date is string && request.resource.data.date.size() <= 60
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.color is string && request.resource.data.color.size() <= 10
        && request.resource.data.locations is list
        && request.resource.data.locations.size() <= 30
        && request.resource.data.rev is int
        && (resource == null || request.resource.data.rev == resource.data.rev + 1)
        && (request.resource.data.who == '' || request.resource.data.who in memberIds())
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at is int;
      allow delete: if false;
    }

    // ---------- 主页：收藏（只有 Faro 能写；公开的所有人可读）----------
    function isOwner() {
      return request.auth != null && request.auth.uid == 'X8BxRGYdemf6Wwb9MtQcLAxpy5q2';
    }
    function validFavorite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'category', 'lat', 'lng', 'rating', 'note', 'city', 'country',
                               'tripId', 'visitedAt', 'price', 'tags', 'link', 'private', 'at', 'updatedAt',
                               'status', 'nameLocal', 'address', 'district', 'cuisine', 'source', 'countryCode', 'visits'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.category in ['food', 'cafe', 'bar', 'spot', 'stay', 'shop', 'other']
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        // 想去 (want) may be saved without stars; 去过 (been, or no status on old entries) needs 1–5
        && (!('status' in d) || d.status in ['been', 'want'])
        && d.rating is int && d.rating <= 5
        && (d.rating >= 1 || (d.rating == 0 && d.get('status', 'been') == 'want'))
        && (!('nameLocal' in d) || (d.nameLocal is string && d.nameLocal.size() <= 60))
        && (!('address' in d) || (d.address is string && d.address.size() <= 200))
        && (!('district' in d) || (d.district is string && d.district.size() <= 30))
        && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 20))
        && (!('source' in d) || d.source in ['naver', 'kakao', 'amap', 'dianping', 'xhs', 'google', 'photo', 'other', 'manual', 'search'])
        && (!('countryCode' in d) || (d.countryCode is string && d.countryCode.size() <= 2))
        && (!('visits' in d) || (d.visits is list && d.visits.size() <= 100))   // 到访日期 YYYY-MM-DD
        && d.note is string && d.note.size() <= 500
        && d.city is string && d.city.size() <= 30
        && d.country is string && d.country.size() <= 30
        && (d.tripId == null || (d.tripId is string && d.tripId.size() <= 40))
        && (d.visitedAt == null || (d.visitedAt is string && d.visitedAt.size() == 10))
        && d.price is int && d.price >= 0 && d.price <= 4
        && d.tags is list && d.tags.size() <= 8
        && d.link is string && d.link.size() <= 500
        && (d.link == '' || d.link.matches('https?://.+'))
        && d.private is bool
        && d.at is int && d.updatedAt is int;
    }
    match /favorites/{id} {
      allow read: if resource.data.private == false || isOwner();
      allow create, update: if isOwner() && validFavorite();
      allow delete: if isOwner();
    }

    // ---------- 工具箱：行李检查（每人一份）----------
    match /packing/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && docId in memberIds()
        && request.resource.data.keys().hasOnly(['items', 'custom', 'checkout', 'at'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 150
        && request.resource.data.custom is list
        && request.resource.data.custom.size() <= 30
        && request.resource.data.checkout is map
        && request.resource.data.checkout.keys().hasOnly(['hyatt', 'fusion'])
        && request.resource.data.at is int;
    }

    // ================= 多次旅行：trips/{tripId}/…（一套代码，多次旅行）=================
    // Old top-level collections above stay until the Vietnam migration is confirmed.
    // Each helper call costs one document read: keep them few per rule.
    function tripPath(t) { return /databases/$(database)/documents/trips/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/trips/$(t)/members/$(request.auth.uid); }
    function tripOf(t) { return get(tripPath(t)).data; }
    function isTripMember(t) { return signedIn() && (isOwner() || exists(memberPath(t))); }
    function canReadTrip(t) { return isTripMember(t) || tripOf(t).visibility == 'link'; }
    function tripMembers(t) { return tripOf(t).members.keys(); }
    // the member (m1–m8) this device picked; one person may use several devices
    function myMember(t) { return get(memberPath(t)).data.get('member', null); }
    // writer stamps: by = this device; byMember (optional) = the member this device picked
    function stampsOk(t, d) {
      return (d.by == request.auth.uid || isOwner())
        && (!('byMember' in d) || isOwner() || d.byMember == myMember(t));
    }
    // "only the recorder": the same member on any of their devices, or (old entries) the same device
    function ownEntry(t) {
      return resource.data.by == request.auth.uid
        || ('byMember' in resource.data && resource.data.byMember != null && exists(memberPath(t)) && resource.data.byMember == myMember(t));
    }
    function okCurrency(c) { return c in ['CNY', 'VND', 'KRW', 'USD', 'TWD', 'JPY', 'THB', 'HKD', 'EUR', 'SGD', 'MYR']; }
    function validTrip() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'start', 'end', 'country', 'countryCode', 'route', 'places', 'color', 'summary', 'coverPos',
                               'members', 'modules', 'currencies', 'baseCurrency', 'rates', 'ratesAt', 'joinCode', 'visibility', 'owner', 'at', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.start is string && d.start.size() == 10 && d.end is string && d.end.size() == 10
        && d.members is map && d.members.size() <= 8
        && d.members.keys().hasOnly(['m1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8'])
        && d.modules is map && d.modules.keys().hasOnly(['guide', 'tools', 'bills', 'packing', 'vote'])
        && d.joinCode is string && d.joinCode.size() >= 8 && d.joinCode.size() <= 40
        && d.visibility in ['members', 'link']
        && d.owner == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if resource.data.visibility == 'link' || isTripMember(tripId);
      allow create: if isOwner() && validTrip();
      // the owner edits everything; members may only refresh the shared exchange rates
      allow update: if (isOwner() && validTrip())
        || (isTripMember(tripId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rates', 'ratesAt', 'updatedAt'])
            && request.resource.data.rates is map);
      allow delete: if isOwner();

      // devices that joined: { code, member, at }. Joining needs the current invite code.
      match /members/{uid} {
        allow read: if isTripMember(tripId);
        allow create: if (isOwner() && request.resource.data.keys().hasOnly(['code', 'member', 'at']))
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['code', 'member', 'at'])
              && request.resource.data.code == tripOf(tripId).joinCode
              && (request.resource.data.get('member', null) == null || request.resource.data.member in tripMembers(tripId)));
        allow update: if isOwner()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['code', 'member', 'at'])
              && request.resource.data.code == resource.data.code
              && (request.resource.data.get('member', null) == null || request.resource.data.member in tripMembers(tripId)));
        allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
      }

      match /cover/{docId} { allow read: if canReadTrip(tripId); allow write: if isOwner(); }
      match /info/{docId}  { allow read: if canReadTrip(tripId); allow write: if isOwner(); }

      match /expenses/{id} {
        allow read: if canReadTrip(tripId);
        allow create: if isTripMember(tripId) && validTripExpense(tripId) && stampsOk(tripId, request.resource.data);
        allow update: if isTripMember(tripId) && (isOwner() || ownEntry(tripId)) && validTripExpense(tripId)
          && request.resource.data.by == resource.data.by;
        allow delete: if isTripMember(tripId) && (isOwner() || ownEntry(tripId));
      }
      match /settlements/{id} {
        allow read: if canReadTrip(tripId);
        allow create: if isTripMember(tripId) && stampsOk(tripId, request.resource.data)
          && request.resource.data.keys().hasOnly(['from', 'to', 'amount', 'currency', 'cny', 'method', 'note', 'at', 'by', 'byMember'])
          && request.resource.data.from in tripMembers(tripId) && request.resource.data.to in tripMembers(tripId)
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 10000000000
          && okCurrency(request.resource.data.currency)
          && request.resource.data.cny is number && request.resource.data.cny > 0
          && request.resource.data.method in ['wechat', 'alipay', 'cash', 'bank', 'other']
          && request.resource.data.note is string && request.resource.data.note.size() <= 60
          && request.resource.data.at is int;
        allow update: if false;
        allow delete: if isTripMember(tripId) && (isOwner() || ownEntry(tripId));
      }
      match /checklist/{docId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if isTripMember(tripId)
          && (docId == 'group' || docId in tripMembers(tripId))
          && request.resource.data.keys().hasOnly(['items', 'at'])
          && request.resource.data.items is map && request.resource.data.items.size() <= 60
          && request.resource.data.at is int;
        allow delete: if isOwner();   // deleting the whole trip
      }
      match /packing/{docId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if isTripMember(tripId) && docId in tripMembers(tripId)
          && request.resource.data.keys().hasOnly(['items', 'custom', 'checkout', 'at'])
          && request.resource.data.items is map && request.resource.data.items.size() <= 200
          && request.resource.data.custom is list && request.resource.data.custom.size() <= 30
          && request.resource.data.checkout is map
          && request.resource.data.at is int;
        allow delete: if isOwner();
      }
      match /links/{id} {
        allow read: if canReadTrip(tripId);
        allow create: if isTripMember(tripId) && stampsOk(tripId, request.resource.data)
          && request.resource.data.keys().hasOnly(['title', 'url', 'tag', 'who', 'by', 'byMember', 'at'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.url is string && request.resource.data.url.size() <= 500 && request.resource.data.url.matches('https?://.+')
          && request.resource.data.tag in ['签证', '交通', '住宿', '吃喝', '玩乐', '其他']
          && (request.resource.data.who == '' || request.resource.data.who in tripMembers(tripId))
          && request.resource.data.at is int;
        allow delete: if isTripMember(tripId) && (isOwner() || ownEntry(tripId));
      }
      match /days/{dayId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if isTripMember(tripId)
          && dayId.matches('d[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['label', 'date', 'title', 'color', 'locations', 'rev', 'who', 'by', 'at'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.locations is list && request.resource.data.locations.size() <= 40
          && request.resource.data.rev is int
          && (resource == null || isOwner() || request.resource.data.rev == resource.data.rev + 1)
          && (request.resource.data.who == '' || request.resource.data.who in tripMembers(tripId))
          && (request.resource.data.by == request.auth.uid || isOwner())
          && request.resource.data.at is int;
        allow delete: if isOwner();
      }
      match /polls/{pid} {
        allow read: if canReadTrip(tripId);
        allow create: if isTripMember(tripId) && stampsOk(tripId, request.resource.data)
          && request.resource.data.keys().hasOnly(['title', 'options', 'multi', 'closed', 'who', 'by', 'byMember', 'at'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.options is list && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 8;
        allow update: if isTripMember(tripId) && (isOwner() || ownEntry(tripId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'title', 'options', 'multi']);
        allow delete: if isTripMember(tripId) && (isOwner() || ownEntry(tripId));
        match /ballots/{mid} {
          allow read: if canReadTrip(tripId);
          allow create, update: if isTripMember(tripId) && mid in tripMembers(tripId)
            && request.resource.data.keys().hasOnly(['choices', 'by', 'at'])
            && request.resource.data.choices is list && request.resource.data.choices.size() >= 1 && request.resource.data.choices.size() <= 8
            && (request.resource.data.by == request.auth.uid || isOwner())
            && (isOwner() || get(/databases/$(database)/documents/trips/$(tripId)/polls/$(pid)).data.closed == false);
          allow delete: if isTripMember(tripId) && mid in tripMembers(tripId);
        }
      }
      // the first Vietnam survey (destination vote, quiz, notes): kept as read-only history
      match /{legacy}/{docId} {
        allow read: if legacy in ['people', 'votes', 'quiz', 'notes'] && canReadTrip(tripId);
        allow write: if legacy in ['people', 'votes', 'quiz', 'notes'] && isOwner();
      }
    }
    function validTripExpense(t) {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'amount', 'currency', 'payer', 'split', 'at', 'by', 'byMember',
                               'mode', 'shares', 'cny', 'rate', 'settled', 'cat', 'day', 'note'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.amount is number && d.amount > 0 && d.amount < 10000000000
        && okCurrency(d.currency)
        && d.payer in tripMembers(t)
        && d.split is list && d.split.size() >= 1 && d.split.size() <= 8
        && d.split.hasOnly(tripMembers(t))
        && d.at is int
        && (!('mode' in d) || d.mode in ['equal', 'shares', 'amounts'])
        && (!('shares' in d) || (d.shares is map && d.shares.keys().hasOnly(tripMembers(t))))
        && (!('cny' in d) || (d.cny is number && d.cny > 0))
        && (!('rate' in d) || (d.rate is number && d.rate > 0))
        && (!('settled' in d) || d.settled is bool)
        && (!('cat' in d) || d.cat in ['food', 'transport', 'stay', 'fun', 'shop', 'other'])
        && (!('day' in d) || (d.day is string && d.day.size() == 10))
        && (!('note' in d) || (d.note is string && d.note.size() <= 120));
    }
    // checklist / packing templates (no personal data): anyone signed in reads, only the owner writes
    match /templates/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // the owner's personal budget plans (homepage 预算): nobody else reads or writes them
    match /budgets/{id} {
      allow read, write: if isOwner();
    }
  }
}
